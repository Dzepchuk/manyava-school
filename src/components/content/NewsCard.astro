---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/dates/format';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
---

<article class="publication-card">
  {
    entry.data.cover && (
      <img
        src={entry.data.cover.src}
        alt={entry.data.cover.alt}
        width={entry.data.cover.width}
        height={entry.data.cover.height}
        loading="lazy"
      />
    )
  }
  <div class="card-body">
    <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time
    >
    <h2><a href={`/news/${entry.id}/`}>{entry.data.title}</a></h2>
    <p>{entry.data.description}</p>
  </div>
</article>

<style>
  .publication-card {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 30px rgba(30, 67, 47, 0.05);
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .card-body {
    padding: 1.5rem;
  }
  time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  h2 {
    margin: 0.6rem 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    overflow-wrap: anywhere;
  }
  h2 a {
    color: var(--color-ink);
  }
  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
