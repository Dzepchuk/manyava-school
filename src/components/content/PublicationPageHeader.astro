---
import Breadcrumbs from '../common/Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  breadcrumbs: { label: string; href?: string }[];
}
const { eyebrow, title, description, breadcrumbs } = Astro.props;
---

<Breadcrumbs items={breadcrumbs} />
<header class="publication-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
</header>

<style>
  .publication-heading {
    max-width: 58rem;
    margin: var(--page-heading-gap) 0 clamp(1.5rem, 3vw, 2rem);
  }
  h1 {
    margin: 0;
  }
  .lead {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }
</style>
