---
import Container from '../components/common/Container.astro';
import { loadSiteData } from '../lib/content/load-site-data';
import { createSeoMetadata } from '../lib/seo/metadata';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { site, navigation } = loadSiteData();
const {
  title = site.defaultSeo.title,
  description = site.defaultSeo.description,
  noindex = false,
} = Astro.props;
const seo = createSeoMetadata({
  title,
  description,
  pathname: Astro.url.pathname,
  site: Astro.site ?? new URL(site.siteUrl),
  noindex,
});
const visibleNavigation = navigation
  .filter(({ visible }) => visible)
  .sort((a, b) => a.order - b.order);
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <meta property="og:title" content={seo.openGraph.title} />
    <meta property="og:description" content={seo.openGraph.description} />
    <meta property="og:url" content={seo.openGraph.url} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" href="/favicon.svg" />
    <title>{seo.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти до основного змісту</a>
    <header class="site-header">
      <Container class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">М</span>
          <span>{site.shortName}</span>
        </a>
        <nav class="site-nav" aria-label="Основна навігація">
          <ul>
            {
              visibleNavigation.map((item) => (
                <li>
                  <a href={item.path}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </Container>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="footer-inner">
        <p><strong>{site.officialName}</strong></p>
        <p>Офіційний сайт · Українська</p>
      </Container>
    </footer>
  </body>
</html>
