---
import Container from '../components/common/Container.astro';
import SiteNavigation from '../components/navigation/SiteNavigation.astro';
import SearchMetadata from '../components/search/SearchMetadata.astro';
import { loadSiteData } from '../lib/content/load-site-data';
import { createSeoMetadata } from '../lib/seo/metadata';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  contentType?: string;
  contentDate?: Date;
  searchKeywords?: string[];
  image?: string;
}

const { site, navigation } = loadSiteData();
const {
  title = site.defaultSeo.title,
  description = site.defaultSeo.description,
  noindex = false,
  contentType = 'Сторінка',
  contentDate,
  searchKeywords = [],
  image = '/media/default-social.webp',
} = Astro.props;
const seo = createSeoMetadata({
  title,
  description,
  pathname: Astro.url.pathname,
  site: Astro.site ?? new URL(site.siteUrl),
  noindex,
  image,
});
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <meta property="og:title" content={seo.openGraph.title} />
    <meta property="og:description" content={seo.openGraph.description} />
    <meta property="og:url" content={seo.openGraph.url} />
    {seo.openGraph.image && <meta property="og:image" content={seo.openGraph.image} />}
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Новини Манявського ліцею"
      href="/rss.xml"
    />
    {!noindex && <SearchMetadata type={contentType} date={contentDate} keywords={searchKeywords} />}
    <title>{seo.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти до основного змісту</a>
    <header class="site-header">
      <Container class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">М</span>
          <span>{site.shortName}</span>
        </a>
        <SiteNavigation items={navigation} currentPath={Astro.url.pathname} />
      </Container>
    </header>
    <main id="main-content" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="footer-inner">
        <p><strong>{site.officialName}</strong></p>
        <p>Офіційний сайт · Українська</p>
      </Container>
    </footer>
  </body>
</html>
