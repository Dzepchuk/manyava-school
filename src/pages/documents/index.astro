---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Container from '../../components/common/Container.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadDocumentData } from '../../lib/content/load-document-data';
import { formatDate } from '../../lib/dates/format';

const { categories } = loadDocumentData();
const categoryNames = new Map(categories.map((category) => [category.id, category.label]));
const documents = (await getCollection('documents'))
  .filter(({ data }) => data.review.status === 'published')
  .sort((left, right) => right.data.documentDate.getTime() - left.data.documentDate.getTime());
const years = [...new Set(documents.map(({ data }) => data.documentDate.getFullYear()))].sort(
  (left, right) => right - left,
);
---

<BaseLayout
  title="Офіційні документи — Манявський ліцей"
  description="Каталог опублікованих документів Манявського ліцею з фільтрами за назвою, категорією та роком."
>
  <Container class="page-shell">
    <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Документи' }]} />

    <header class="page-heading">
      <p class="eyebrow">Відкриті матеріали</p>
      <h1>Офіційні документи</h1>
      <p>
        Знайдіть документ за назвою, категорією або роком. Метадані залишаються доступними, навіть
        якщо завантаження файла тимчасово неможливе.
      </p>
    </header>

    <form class="filters" action="/documents/" method="get" aria-label="Фільтри документів">
      <label>
        Назва
        <input
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Наприклад, освітня програма"
        />
      </label>
      <label>
        Категорія
        <select name="category">
          <option value="">Усі категорії</option>
          {
            categories
              .filter(({ active }) => active)
              .sort((left, right) => left.order - right.order)
              .map((category) => <option value={category.id}>{category.label}</option>)
          }
        </select>
      </label>
      <label>
        Рік
        <select name="year">
          <option value="">Усі роки</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <button type="submit">Застосувати</button>
      <a href="/documents/">Очистити</a>
    </form>

    <p id="document-results-status" class="results-status" aria-live="polite"></p>

    {
      documents.length > 0 ? (
        <div class="document-list" id="document-list">
          {documents.map((entry) => (
            <article
              class="document-card"
              data-document
              data-title={entry.data.title.toLocaleLowerCase('uk')}
              data-category={entry.data.categoryId}
              data-year={entry.data.documentDate.getFullYear()}
            >
              <p class="category">{categoryNames.get(entry.data.categoryId) ?? 'Інша категорія'}</p>
              <h2>
                <a href={`/documents/${entry.id}/`}>{entry.data.title}</a>
              </h2>
              <p>{entry.data.description}</p>
              <dl>
                <div>
                  <dt>Дата документа</dt>
                  <dd>
                    <time datetime={entry.data.documentDate.toISOString()}>
                      {formatDate(entry.data.documentDate)}
                    </time>
                  </dd>
                </div>
                <div>
                  <dt>Статус</dt>
                  <dd>{entry.data.versionStatus === 'current' ? 'Чинний' : 'Архівний'}</dd>
                </div>
                <div>
                  <dt>Тип файла</dt>
                  <dd>{entry.data.file.mimeType}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      ) : (
        <section class="empty-state" aria-labelledby="empty-title">
          <h2 id="empty-title">Каталог готується до наповнення</h2>
          <p>
            Підтверджені офіційні документи ще не опубліковано. Ми не показуємо неперевірені файли
            або правові припущення.
          </p>
          <a href="/contacts/">Уточнити інформацію в ліцеї</a>
        </section>
      )
    }

    <section class="no-results" id="document-no-results" hidden aria-labelledby="no-results-title">
      <h2 id="no-results-title">Документів за цими умовами не знайдено</h2>
      <p>Спробуйте коротшу назву, іншу категорію або очистьте фільтри.</p>
    </section>
  </Container>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const form = document.querySelector<HTMLFormElement>('.filters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-document]')];
  const status = document.querySelector<HTMLElement>('#document-results-status');
  const noResults = document.querySelector<HTMLElement>('#document-no-results');

  if (form) {
    const queryInput = form.elements.namedItem('q') as HTMLInputElement | null;
    const categoryInput = form.elements.namedItem('category') as HTMLSelectElement | null;
    const yearInput = form.elements.namedItem('year') as HTMLSelectElement | null;

    if (queryInput) queryInput.value = params.get('q') ?? '';
    if (categoryInput) categoryInput.value = params.get('category') ?? '';
    if (yearInput) yearInput.value = params.get('year') ?? '';

    const query = (params.get('q') ?? '').trim().toLocaleLowerCase('uk');
    const category = params.get('category') ?? '';
    const year = params.get('year') ?? '';
    let visible = 0;

    for (const card of cards) {
      const matches =
        (!query || card.dataset.title?.includes(query)) &&
        (!category || card.dataset.category === category) &&
        (!year || card.dataset.year === year);
      card.hidden = !matches;
      if (matches) visible += 1;
    }

    if (status && cards.length > 0) {
      status.textContent = `Знайдено документів: ${visible}`;
    }
    if (noResults) noResults.hidden = cards.length === 0 || visible > 0;
  }
</script>

<style>
  .page-shell {
    padding-block: 2rem 5rem;
  }
  .page-heading {
    max-width: 58rem;
    margin: clamp(3rem, 8vw, 6rem) 0 2rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .page-heading > p:last-child {
    color: var(--color-muted);
    font-size: 1.15rem;
  }
  .filters {
    display: grid;
    align-items: end;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-soft);
    border-radius: var(--radius-md);
    grid-template-columns: minmax(12rem, 2fr) repeat(2, minmax(9rem, 1fr)) auto auto;
  }
  .filters label {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    font-weight: 700;
  }
  input,
  select,
  button {
    box-sizing: border-box;
    min-height: 2.9rem;
    padding: 0.6rem 0.75rem;
    color: inherit;
    background: white;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    font: inherit;
  }
  input,
  select {
    width: 100%;
    min-width: 0;
  }
  button {
    color: white;
    background: var(--color-primary);
    cursor: pointer;
    font-weight: 700;
  }
  .results-status {
    min-height: 1.5rem;
    color: var(--color-muted);
  }
  .document-list {
    display: grid;
    gap: 1rem;
  }
  .document-card,
  .empty-state,
  .no-results {
    padding: clamp(1.4rem, 4vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }
  .document-card h2,
  .empty-state h2,
  .no-results h2 {
    margin-top: 0;
  }
  .category {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 0;
  }
  dt {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 700;
  }
  [hidden] {
    display: none;
  }
  @media (max-width: 56rem) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 36rem) {
    .filters {
      grid-template-columns: 1fr;
    }
  }
</style>
