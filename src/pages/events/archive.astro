---
import { getCollection } from 'astro:content';
import Container from '../../components/common/Container.astro';
import EventCard from '../../components/content/EventCard.astro';
import PublicationPageHeader from '../../components/content/PublicationPageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitEventsByDate } from '../../lib/content/publications';
const entries = await getCollection('events');
const { archived } = splitEventsByDate(entries.map(({ data }) => data));
const archivedEntries = archived.map((data) => entries.find((entry) => entry.data === data)!);
---

<BaseLayout title="Архів подій — Манявський ліцей">
  <Container class="publication-shell">
    <PublicationPageHeader
      eyebrow="Календар"
      title="Архів подій"
      description="Завершені події Манявського ліцею."
      breadcrumbs={[
        { label: 'Головна', href: '/' },
        { label: 'Події', href: '/events/' },
        { label: 'Архів' },
      ]}
    />
    {
      archivedEntries.length ? (
        <div class="publication-grid">
          {archivedEntries.map((entry) => (
            <EventCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">В архіві подій поки немає матеріалів.</p>
      )
    }
  </Container>
</BaseLayout>
<style>
  .publication-shell {
    padding-block: 2rem 4rem;
  }
  .publication-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .empty {
    padding: 1.5rem;
    background: var(--color-soft);
    border-radius: var(--radius-md);
  }
</style>
