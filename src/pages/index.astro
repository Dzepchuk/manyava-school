---
import { getCollection } from 'astro:content';
import Container from '../components/common/Container.astro';
import EventCard from '../components/content/EventCard.astro';
import NewsCard from '../components/content/NewsCard.astro';
import NoticeCard from '../components/content/NoticeCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteData } from '../lib/content/load-site-data';
import { isPublished, splitEventsByDate, splitNoticesByExpiry } from '../lib/content/publications';

const { site } = loadSiteData();
const newsEntries = await getCollection('news');
const noticeEntries = await getCollection('notices');
const eventEntries = await getCollection('events');
const latestNews = newsEntries
  .filter(({ data }) => isPublished(data))
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime())
  .slice(0, 1);
const { current: currentNotices } = splitNoticesByExpiry(noticeEntries.map(({ data }) => data));
const { upcoming: upcomingEvents } = splitEventsByDate(eventEntries.map(({ data }) => data));
const latestNotices = currentNotices
  .slice(0, 1)
  .map((data) => noticeEntries.find((entry) => entry.data === data)!);
const nearestEvents = upcomingEvents
  .slice(0, 1)
  .map((data) => eventEntries.find((entry) => entry.data === data)!);
---

<BaseLayout>
  <section class="hero">
    <Container class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Офіційний сайт</p>
        <h1>Манявський ліцей</h1>
        <p class="lead">Простір знань, взаємоповаги та розвитку в серці Карпатської громади.</p>
        <div class="actions">
          <a class="button primary" href="#essentials">Основна інформація</a>
          <a class="button secondary" href="/contacts/">Контакти ліцею</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="sun"></div>
        <div class="mountain far"></div>
        <div class="mountain near"></div>
        <div class="school">
          <span></span><span></span><span></span>
        </div>
      </div>
    </Container>
  </section>

  <Container as="section" class="updates">
    <h2 class="compact-heading">Актуальне</h2>
    <div class="update-columns">
      <section aria-labelledby="latest-news">
        <div class="update-title">
          <h3 id="latest-news">Остання новина</h3><a href="/news/">Усі новини</a>
        </div>
        {
          latestNews.length ? (
            latestNews.map((entry) => <NewsCard entry={entry} />)
          ) : (
            <p class="empty">Новин ще немає.</p>
          )
        }
      </section>
      <section aria-labelledby="current-notices">
        <div class="update-title">
          <h3 id="current-notices">Оголошення</h3><a href="/notices/">Усі оголошення</a>
        </div>
        {
          latestNotices.length ? (
            latestNotices.map((entry) => <NoticeCard entry={entry} />)
          ) : (
            <p class="empty">Наразі немає актуальних оголошень.</p>
          )
        }
      </section>
      <section aria-labelledby="nearest-events">
        <div class="update-title">
          <h3 id="nearest-events">Найближча подія</h3><a href="/events/">Усі події</a>
        </div>
        {
          nearestEvents.length ? (
            nearestEvents.map((entry) => <EventCard entry={entry} />)
          ) : (
            <p class="empty">Наразі немає підтверджених подій.</p>
          )
        }
      </section>
    </div>
  </Container>

  <Container as="section" class="preview" id="essentials">
    <h2 class="compact-heading">Основна інформація</h2>
    <div class="cards">
      <article>
        <span class="card-number">01</span>
        <h3>Про ліцей</h3>
        <p>Підтверджені відомості про заклад, освітні рівні та шкільну спільноту.</p>
        <a class="card-link" href="/about/"
          >Переглянути відомості <span aria-hidden="true">→</span></a
        >
      </article>
      <article>
        <span class="card-number">02</span>
        <h3>Вступ</h3>
        <p>Актуальний стан правил прийому та безпечний спосіб уточнити інформацію.</p>
        <a class="card-link" href="/admission/">Вступ до ліцею <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <span class="card-number">03</span>
        <h3>Контакти</h3>
        <p>{site.address}. Публікуємо лише перевірені ліцеєм способи зв’язку.</p>
        <a class="card-link" href="/contacts/"
          >Переглянути контакти <span aria-hidden="true">→</span></a
        >
      </article>
    </div>
  </Container>

  <Container as="section" class="school-intro">
    <div class="school-intro-heading">
      <div>
        <p class="eyebrow">Манявський ліцей</p>
        <h2>Освіта, розвиток і спільнота в серці Маняви</h2>
      </div>
      <p>
        Комунальний опорний заклад, що об’єднує дошкільну, початкову, базову та профільну середню
        освіту.
      </p>
    </div>

    <div class="intro-points">
      <article>
        <span class="point-number" aria-hidden="true">01</span>
        <h3>Освітній шлях</h3>
        <p>Від дошкільного відділення до підготовки старшокласників до свідомого вибору.</p>
      </article>
      <article>
        <span class="point-number" aria-hidden="true">02</span>
        <h3>Безпечне середовище</h3>
        <p>Простір взаємоповаги, відповідальності та підтримки кожного учасника спільноти.</p>
      </article>
      <article>
        <span class="point-number" aria-hidden="true">03</span>
        <h3>Разом із громадою</h3>
        <p>Навчання, громадянські ініціативи та дбайливе ставлення до рідної Маняви.</p>
      </article>
    </div>

    <a class="about-link" href="/about/">
      Дізнатися більше про ліцей
      <span aria-hidden="true">↗</span>
    </a>
  </Container>
</BaseLayout>

<style>
  .hero {
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }
  h1 {
    margin: 0;
  }
  .lead {
    max-width: 38rem;
    margin: 1rem 0 1.25rem;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .button {
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }
  .primary {
    color: white;
    background: var(--color-primary);
  }
  .secondary {
    color: var(--color-primary);
  }
  .hero-art {
    position: relative;
    width: 100%;
    max-width: 24rem;
    min-height: 16rem;
    justify-self: end;
    overflow: hidden;
    background: linear-gradient(160deg, #e2ede5, #f6e8c9);
    border: 0.6rem solid white;
    border-radius: 48% 52% 44% 56% / 44% 40% 60% 56%;
    box-shadow: var(--shadow-soft);
  }
  .sun {
    position: absolute;
    top: 3rem;
    right: 4rem;
    width: 5rem;
    height: 5rem;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .mountain {
    position: absolute;
    right: -20%;
    bottom: -10%;
    left: -20%;
    height: 67%;
    background: #5c866a;
    clip-path: polygon(
      0 78%,
      17% 37%,
      28% 62%,
      45% 15%,
      67% 66%,
      79% 38%,
      100% 82%,
      100% 100%,
      0 100%
    );
  }
  .mountain.far {
    bottom: 17%;
    background: #a5bda9;
  }
  .mountain.near {
    background: #235b40;
  }
  .school {
    position: absolute;
    z-index: 2;
    right: 21%;
    bottom: 12%;
    display: flex;
    gap: 0.7rem;
    width: 58%;
    height: 24%;
    align-items: center;
    justify-content: center;
    background: #fffaf0;
    border-radius: 0.2rem;
    box-shadow: 0 10px 30px rgba(13, 48, 30, 0.2);
  }
  .school::before {
    position: absolute;
    top: -45%;
    width: 112%;
    height: 52%;
    background: #8f4f39;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    content: '';
  }
  .school span {
    width: 15%;
    height: 42%;
    background: #78a18a;
    border-radius: 0.15rem;
  }
  .preview,
  .updates {
    padding-block: clamp(1rem, 2vw, 1.5rem);
  }
  .school-intro {
    padding-block: 4rem;
  }
  .compact-heading {
    margin: 0 0 1.5rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.025em;
  }
  .school-intro h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .update-columns {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .update-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .update-title h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .update-title a {
    flex: none;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .empty {
    min-height: 9rem;
    margin: 0;
    padding: 1.5rem;
    color: var(--color-muted);
    background: var(--color-soft);
    border-radius: var(--radius-md);
  }
  .cards article {
    padding: 1.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 30px rgba(30, 67, 47, 0.05);
  }
  .card-number {
    color: #8a5906;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .cards h3 {
    margin: 2rem 0 0.7rem;
    font-size: 1.55rem;
  }
  .cards p {
    color: var(--color-muted);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration-thickness: 1px;
  }

  .card-link span {
    transition: transform 160ms ease;
  }

  .card-link:hover span {
    transform: translateX(0.2rem);
  }
  .school-intro {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    padding-inline: clamp(1.4rem, 5vw, 4rem);
    color: white;
    background: var(--color-primary);
    border-radius: var(--radius-lg);
  }

  .school-intro .eyebrow {
    color: #f3ca81;
  }

  .school-intro-heading {
    display: grid;
    align-items: end;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
  }

  .school-intro-heading > p {
    max-width: 31rem;
    margin: 0 0 0.45rem;
    color: #d6e5db;
    font-size: 1.05rem;
  }

  .intro-points {
    display: grid;
    gap: 1px;
    margin-top: 3rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-md);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .intro-points article {
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--color-primary);
  }

  .point-number {
    color: #f3ca81;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .intro-points h3 {
    margin: 1.6rem 0 0.7rem;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  .intro-points p {
    margin: 0;
    color: #d6e5db;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2rem;
    padding-bottom: 0.2rem;
    color: white;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    font-weight: 700;
    text-decoration: none;
  }

  .about-link:hover {
    color: #f3ca81;
  }

  @media (max-width: 48rem) {
    .hero-grid,
    .cards,
    .update-columns,
    .school-intro-heading,
    .intro-points {
      grid-template-columns: 1fr;
    }
    .hero-art {
      display: none;
    }
  }
</style>
