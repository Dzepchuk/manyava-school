---
import { getCollection } from 'astro:content';
import Container from '../../components/common/Container.astro';
import NewsCard from '../../components/content/NewsCard.astro';
import PublicationPageHeader from '../../components/content/PublicationPageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished } from '../../lib/content/publications';
import { loadSiteData } from '../../lib/content/load-site-data';

const { site } = loadSiteData();
const news = (await getCollection('news'))
  .filter(({ data }) => isPublished(data))
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime());
---

<BaseLayout
  title={`Новини ліцею — ${site.shortName}`}
  description="Перевірені новини Манявського ліцею."
>
  <Container class="publication-shell">
    <PublicationPageHeader
      eyebrow="Життя ліцею"
      title="Новини ліцею"
      description="Перевірені повідомлення про роботу й життя Манявського ліцею."
      breadcrumbs={[{ label: 'Головна', href: '/' }, { label: 'Новини' }]}
    />
    {
      news.length ? (
        <div class="publication-grid">
          {news.map((entry) => (
            <NewsCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">Новини будуть додані після перевірки.</p>
      )
    }
    <a class="archive-link" href="/news/archive/">Архів новин <span aria-hidden="true">→</span></a>
  </Container>
</BaseLayout>

<style>
  .publication-shell {
    padding-block: 2rem 4rem;
  }
  .publication-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .empty {
    padding: 1.5rem;
    background: var(--color-soft);
    border-radius: var(--radius-md);
  }
  .archive-link {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 800;
  }
</style>
