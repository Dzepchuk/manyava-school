---
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Container from '../../components/common/Container.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Батькам — Манявський ліцей"
  description="Основні розділи для батьків: вступ, навчання, харчування, безпека та зв’язок із Манявським ліцеєм."
>
  <Container class="page-shell">
    <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Батькам' }]} />
    <header class="page-heading">
      <p class="eyebrow">Батькам</p>
      <h1>Інформація для родин</h1>
      <p>Швидкі переходи до підтверджених матеріалів і офіційних контактів ліцею.</p>
    </header>
    <div class="link-grid">
      <a href="/admission/"
        ><strong>Вступ до ліцею</strong><span>Порядок уточнення умов і документів</span></a
      >
      <a href="/parents/learning/"
        ><strong>Організація навчання</strong><span>Навчальний процес і актуальні повідомлення</span
        ></a
      >
      <a href="/parents/meals/"
        ><strong>Харчування</strong><span>Підтверджена інформація та оновлення</span></a
      >
      <a href="/students/clubs/"
        ><strong>Гуртки</strong><span>Заняття в ліцеї та позашкільна освіта</span></a
      >
      <a href="/parents/safety/"><strong>Безпека</strong><span>Безпечне освітнє середовище</span></a
      >
      <a href="/bullying-prevention/"
        ><strong>Протидія булінгу</strong><span>Безпечні способи звернення</span></a
      >
      <a href="/contacts/"><strong>Контакти</strong><span>Телефон, email і поштова адреса</span></a>
    </div>
  </Container>
</BaseLayout>

<style>
  .page-shell {
    padding-block: 2rem 5rem;
  }
  .page-heading {
    max-width: 54rem;
    margin: clamp(3rem, 8vw, 6rem) 0 2rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .page-heading > p:last-child {
    color: var(--color-muted);
    font-size: 1.15rem;
  }
  .link-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .link-grid a {
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem;
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .link-grid strong {
    color: var(--color-primary);
    font-size: 1.3rem;
  }
  .link-grid span {
    color: var(--color-muted);
  }
  @media (max-width: 40rem) {
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
